# ═══════════════════════════════════════════════════════════════
#  OROS MOBILITY — Configuration
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ── Serveur ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Ports TCP GPS ──────────────────────────────────────────────
PORT_GT06=8090
PORT_TELTONIKA=5027
PORT_H02=5013
PORT_SEEWORLD=8000
PORT_TK103=5002

# ── Base de données PostgreSQL ─────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=oros_gps
DB_USER=oros
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# ── Sécurité JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGER_CE_SECRET_MINIMUM_32_CARACTERES
JWT_EXPIRES=24h

# ── Compte administrateur initial ─────────────────────────────
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# ── Notifications Email (Gmail SMTP) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@gmail.com
SMTP_PASS=votre_app_password

# ── SMS — Orange Business Services CI (recommandé) ─────────────
ORANGE_SMS_API=
ORANGE_SMS_SENDER=OrosMobility

# ── SMS — Infobip (alternative) ────────────────────────────────
INFOBIP_API_KEY=
INFOBIP_SENDER=OrosMobility

# ── SMS — Twilio (fallback international) ─────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── Stockage fichiers (documents) ─────────────────────────────
UPLOAD_DIR=/opt/oros-gps/uploads

# ── URL publique ───────────────────────────────────────────────
PUBLIC_URL=https://votre-domaine.com

# ── GraphHopper (optionnel — isochrones) ──────────────────────
GRAPHHOPPER_KEY=
